DB_MODE="PROD"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Enable the scheduler (true/false)
CRON_ENABLED=true

# How often it should run (in minutes, defaults to 20)
CRON_INTERVAL_MINUTES=20

# Comma-separated list of regions to scrape
CRON_REGIONS="Telangana","Andhra Pradesh","Tamil Nadu","Kerala","Karnataka"

# The language to filter by (defaults to Telugu)
CRON_LANGUAGE="Telugu"

# The exact movie name to search for (leave blank to search all active movies)
CRON_MOVIENAME=